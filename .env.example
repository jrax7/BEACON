APP_NAME=BEACON API
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret

POSTGRES_DB=beacon
POSTGRES_USER=beacon
POSTGRES_PASSWORD=replace-with-a-random-password

DATABASE_URL=postgresql+psycopg://beacon:replace-with-password@postgres:5432/beacon

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Phase 16B browser authentication
# Development values below are intentionally local-friendly.
# Production must use the validated secure equivalents.
BEACON_PUBLIC_URL=http://localhost:5173
BEACON_REGISTRATION_ENABLED=true
BEACON_BROWSER_ORIGINS=http://localhost:5173
BEACON_SESSION_COOKIE_NAME=beacon_session
BEACON_SESSION_COOKIE_SECURE=false
BEACON_SESSION_IDLE_MINUTES=60
BEACON_SESSION_ABSOLUTE_HOURS=12
BEACON_CSRF_SECRET=
BEACON_TRUSTED_PROXY_CIDRS=
BEACON_CLIENT_IP_HEADER=x-forwarded-for

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key

# Authentication email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=BEACON
SMTP_TIMEOUT_SECONDS=10
ALLOW_LAB_TARGETS=false
LAB_ALLOWED_HOSTS=
TARGET_ALLOWED_PORTS=80,443
TARGET_REQUEST_TIMEOUT_SECONDS=10
TARGET_VERIFICATION_TTL_DAYS=30
VERIFICATION_FILE_MAX_BYTES=4096
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=replace-with-a-random-zap-api-key
ZAP_STARTUP_TIMEOUT_SECONDS=120
ZAP_SPIDER_TIMEOUT_SECONDS=120
ZAP_PASSIVE_SCAN_TIMEOUT_SECONDS=180
ZAP_POLL_INTERVAL_SECONDS=2
REPORT_STORAGE_PATH=/app/storage/reports
REPORT_MAX_SAMPLE_URLS=20
RAW_STORAGE_PATH=/app/storage/raw
NMAP_ALLOWED_PORTS=80,443
NMAP_TIMEOUT_SECONDS=120
NMAP_MAX_EXPLICIT_PORTS=64
HTTPX_BINARY=/usr/local/bin/pd-httpx
HTTPX_MAX_RESPONSE_BYTES=1000000
HTTPX_MAX_REDIRECTS=5
KATANA_BINARY=/usr/local/bin/pd-katana
SSLYZE_BINARY=sslyze
NUCLEI_BINARY=/usr/local/bin/pd-nuclei
NUCLEI_TEMPLATE_ROOT=/opt/nuclei-templates
NUCLEI_MAX_OUTPUT_BYTES=10000000
NIKTO_BINARY=nikto
NIKTO_MAX_TIME_SECONDS=120
NIKTO_PROCESS_TIMEOUT_SECONDS=150
NIKTO_REQUEST_TIMEOUT_SECONDS=2
NIKTO_TUNING=23b
NIKTO_USER_AGENT=BEACON-Nikto/0.1
NIKTO_MAX_OUTPUT_BYTES=10000000

# Public demo account
DEMO_USER_EMAIL=demo@beacon.example.com
DEMO_TARGET_URL=http://lab-target/
DEMO_VERIFICATION_TTL_DAYS=3650
# Phase 16A Task 19 scanner runtime policy
CONTROL_WORKER_CONCURRENCY=1
SCANNER_WORKER_CONCURRENCY=1

SCANNER_HEARTBEAT_INTERVAL_SECONDS=15
SCANNER_STALE_AFTER_SECONDS=90
SCANNER_ARTIFACT_MAX_BYTES=52428800
SCANNER_PROCESS_GRACE_SECONDS=5

# Defaults below were selected after measuring the Phase 16A host.
CONTROL_WORKER_CPU_LIMIT=0.50
CONTROL_WORKER_MEMORY_LIMIT=384m
CONTROL_WORKER_PIDS_LIMIT=128

SCANNER_WORKER_CPU_LIMIT=1.25
SCANNER_WORKER_MEMORY_LIMIT=1536m
SCANNER_WORKER_PIDS_LIMIT=256

ZAP_CPU_LIMIT=0.75
ZAP_MEMORY_LIMIT=1280m
ZAP_PIDS_LIMIT=256
